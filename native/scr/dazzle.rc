#include <windows.h>
#include "resource.h"

IDI_DAZZLE ICON "dazzle.ico"
1 RT_MANIFEST "dazzle.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 650, 490
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DAZZLE 5.0 Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 8, 634, 442
    PUSHBUTTON "Import .DZL...", IDC_IMPORT, 8, 458, 92, 22
    PUSHBUTTON "Defaults", IDC_DEFAULTS, 108, 458, 80, 22
    DEFPUSHBUTTON "OK", IDOK, 492, 458, 68, 22
    PUSHBUTTON "Cancel", IDCANCEL, 568, 458, 74, 22
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 5,0,0,0
 PRODUCTVERSION 5,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DAZZLE 5.0 Windows Screen Saver\0"
            VALUE "FileVersion", "5.0.0.0\0"
            VALUE "ProductName", "DAZZLE 5.0\0"
            VALUE "ProductVersion", "5.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

STRINGTABLE
BEGIN
    1 "DAZZLE 5.0"
END
